# ==============================================================================
# OmniBlog Environment Configuration
# ==============================================================================

# Backend Selection:
# Option 1: Vertex AI on Google Cloud (Recommended for GCP production)
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option 2: Google AI Studio API Key (for quick local development)
# GEMINI_API_KEY=your-gemini-api-key

# Model Selection
MODEL_NAME=gemini-2.5-flash

# ADK Storage & State Services
# Session Service: sqlite:///.adk/sessions.db, memory://, or agentengine://...
SESSION_SERVICE_URI=sqlite:///.adk/sessions.db

# Memory Service: sqlite:///.adk/memory.db, memory://, or agentengine://...
MEMORY_SERVICE_URI=sqlite:///.adk/memory.db

# Artifact Service: file://./artifacts, memory://, or gs://your-gcs-bucket
ARTIFACT_SERVICE_URI=file://./artifacts

# Observability & Tracing
ENABLE_CLOUD_TRACE=false
OTEL_SERVICE_NAME=omniblog-agent
LOG_LEVEL=INFO

# Server Config
HOST=0.0.0.0
PORT=8000
